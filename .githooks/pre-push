#!/usr/bin/env bash
# Refuses a direct push to a protected branch, and refuses to push a commit
# attributed to a tool.
#
# Enable it once per clone:
#
#   git config core.hooksPath .githooks
#
# A hook is a local guard, not a guarantee. Anyone can bypass it with
# --no-verify or a fresh clone, which is why the server side rule in
# documentation/branch-protection.md is the one that actually enforces this.
# The hook exists to catch the honest mistake before it reaches the network.
set -u

PROTECTED="main dev"
OVERRIDE="${ALLOW_PROTECTED_PUSH:-}"

fail() {
  printf '\npre-push refused: %s\n\n' "$1" >&2
}

status=0
forbidden='co-authored-by|generated by|created with|assisted by|claude|chatgpt|copilot'

# A runtime name inside a path is a filename, not an attribution. Strip the
# paths the repository legitimately talks about before matching, so that a
# commit renaming CLAUDE.md is not mistaken for a commit written by a tool.
strip_paths() {
  sed -E 's/[Cc][Ll][Aa][Uu][Dd][Ee]\.md//g; s/\.[Cc][Ll][Aa][Uu][Dd][Ee](\.json)?\/?//g'
}

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue

  branch="${remote_ref#refs/heads/}"

  # Deletion of a protected branch.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    case " $PROTECTED " in
      *" $branch "*)
        fail "deleting $branch is not allowed."
        status=1
        ;;
    esac
    continue
  fi

  case " $PROTECTED " in
    *" $branch "*)
      if [ "$OVERRIDE" != "yes" ]; then
        fail "$branch is protected. Open a pull request instead.

  Contributors branch from dev:
    git switch dev && git pull
    git switch -c <type>/<short-description>
    git push -u origin <type>/<short-description>

  A maintainer performing a deliberate release push can override with:
    ALLOW_PROTECTED_PUSH=yes git push origin $branch

  Server side rule: documentation/branch-protection.md"
        status=1
        continue
      fi
      ;;
  esac

  # Range of commits about to be pushed. A new branch has no remote counterpart,
  # so the range is everything this push adds that no origin branch already
  # holds. Scanning shared history instead would refuse a push because of a
  # commit somebody else already merged, which the author of this push cannot
  # fix without rewriting a protected branch.
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    if [ -n "$(git for-each-ref --count=1 --format='%(refname)' refs/remotes/origin 2>/dev/null)" ]; then
      range="$local_sha --not --remotes=origin"
      limit=""
    else
      range="$local_sha"
      limit="--max-count=50"
    fi
  else
    range="$remote_sha..$local_sha"
    limit=""
  fi

  if git log $limit --format='%an%n%ae%n%s%n%b' "$range" 2>/dev/null \
     | strip_paths | grep -qiE "$forbidden"; then
    fail "a commit in $branch attributes the work to a tool.

  Find it:
    git log --format='%h %an <%ae> %s' $range
    git log --format='%h %b' $range | grep -i co-authored

  Amend or rebase it out before pushing. The author of a commit is a person."
    status=1
  fi

  # An empty author is worse than a wrong one: it cannot be traced at all.
  if git log $limit --format='%an|%ae' "$range" 2>/dev/null \
     | grep -qE '^\||\|$'; then
    fail "a commit in $branch has an empty author name or email.

  Set them, then amend:
    git config user.name  \"Your Name\"
    git config user.email \"you@example.org\""
    status=1
  fi
done

exit "$status"
